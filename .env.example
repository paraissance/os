# JodyOS environment variables. Copy to .env.local for local development.
# Never commit real values. On Vercel, set these in Project Settings > Environment Variables.

# --- Database -----------------------------------------------------------------
# Production: any PostgreSQL connection string (Neon from the Vercel Marketplace
# sets this automatically). Use the pooled connection string if offered.
# Local development: leave unset to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# Optional: where the local PGlite database lives (development only).
# PGLITE_DATA_DIR=.data/pglite

# --- First-run setup ----------------------------------------------------------
# Required once, to create the owner account at /setup. 24+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Remove it after setup so the setup page stays locked.
SETUP_TOKEN=

# --- AI -------------------------------------------------------------------------
# Powers Jody Core in AI Command. Without it the app runs and says the AI is offline.
ANTHROPIC_API_KEY=

# Optional: default model until one is chosen in Settings.
# One of: claude-opus-5-5 (default), claude-sonnet-5-5, claude-haiku-5-5
# AI_MODEL=claude-opus-5-5
